# Optional Docker Compose settings. No database service/password is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
prtseek_LLM_PROVIDER=
prtseek_LLM_MODEL=
prtseek_LLM_BASE_URL=
prtseek_LLM_PROXY=
# Shared logical model requests per turn (main + children), 1..100000.
# For multi-hour work, opt in to e.g. 2000; time and stop controls still apply.
prtseek_CTF_MODEL_CALL_LIMIT=200
